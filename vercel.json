{
  "version": 2,
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node"
    },
    {
      "src": "admin-ui/dist/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.ts"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/admin-ui/dist/assets/$1"
    },
    {
      "src": "/(.*\\.svg)",
      "dest": "/admin-ui/dist/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/admin-ui/dist/index.html"
    }
  ]
}
