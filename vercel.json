{
  "version": 2,
  "buildCommand": "cd admin-ui && pnpm install && pnpm run build && cd .. && cp -R public/. .",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.ts"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
