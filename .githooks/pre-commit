#!/bin/sh
# =============================================================================
# Pre-commit Hook: Auto Build Admin UI
# =============================================================================
# Mục đích: Tự động rebuild admin-ui và stage các file tĩnh ra root
#           khi phát hiện có thay đổi trong thư mục admin-ui/
#
# Nguyên lý hoạt động:
#   1. Kiểm tra xem có file nào trong admin-ui/ đang được staged không
#   2. Nếu có -> chạy build:ui để rebuild React app
#   3. Tự động git add các file output (index.html, assets/, ...)
#   4. Tiếp tục commit bình thường
# =============================================================================

# Màu sắc terminal cho dễ đọc
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
RED='\033[0;31m'
RESET='\033[0m'

echo ""

# Kiểm tra xem có file nào trong admin-ui/ đang được staged không
STAGED_UI_FILES=$(git diff --cached --name-only | grep "^admin-ui/")

if [ -z "$STAGED_UI_FILES" ]; then
  # Không có thay đổi admin-ui -> bỏ qua, commit bình thường
  echo "${GREEN}[pre-commit]${RESET} Không phát hiện thay đổi admin-ui. Tiếp tục commit..."
  exit 0
fi

echo "${YELLOW}[pre-commit]${RESET} Phát hiện thay đổi trong admin-ui/. Đang rebuild..."
echo ""

# Chạy build:ui (build React + copy ra root)
pnpm run build:ui

# Kiểm tra kết quả build
if [ $? -ne 0 ]; then
  echo ""
  echo "${RED}[pre-commit] LỖI: Build admin-ui thất bại! Commit đã bị hủy.${RESET}"
  echo "${RED}             Hãy sửa lỗi build trước khi commit lại.${RESET}"
  exit 1
fi

# Stage tất cả file output ra root sau khi build thành công
git add index.html assets/ favicon.svg icons.svg 2>/dev/null

echo ""
echo "${GREEN}[pre-commit] Build thành công! Đã tự động stage các file UI.${RESET}"
echo "${GREEN}             Đang tiến hành commit...${RESET}"
echo ""

exit 0
